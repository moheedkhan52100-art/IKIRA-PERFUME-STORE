
# Copy to .env and replace every placeholder. Never commit .env.
NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=

# Admin credentials are required before admin order management can be used.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Customer login sessions use a separate signing secret (at least 32 characters).
CUSTOMER_SESSION_SECRET=

# Configure all SMTP values together to send store alerts for new orders.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STORE_NOTIFICATION_EMAIL=
